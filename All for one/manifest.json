{
    "manifest_version": 3,
    "name": "Talbat Helper",
    "version": "1.0",
    "description": "All for One by Mohamed Shalaby",
    "permissions": [
        "scripting",
        "activeTab",
        "storage",
        "clipboardWrite",
        "commands"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "commands": {
        "copy-order": {
            "suggested_key": {
                "default": "Alt+1"
            },
            "description": "Copy Order Number"
        },
        "copy-phone": {
            "suggested_key": {
                "default": "Alt+2"
            },
            "description": "Copy Phone Number"
        },
        "bransh-copy": {
            "suggested_key": {
                "default": "Alt+3"
            },
            "description": "Copy Branch Note"
        }
    }
}